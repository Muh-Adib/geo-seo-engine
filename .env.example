# Unicam Programmatic SEO & GEO Engine Configuration
# Port (Rarely used port to avoid clashes with other services like 8000/3000)
PORT=28420
HOST=127.0.0.1

# Engine Secret Key (for remote API and ChatGPT Custom GPT Actions)
ENGINE_API_KEY=geo-engine-secret-2026

# WordPress Bridge Default Security Key
BRIDGE_SECRET_KEY=unicam-geo-secret-key-2026

# Database
DATABASE_URL=sqlite:///./db/seo_engine.db

# Optional Google Gemini API Keys (comma-separated for multi-account pool)
# Note: Antigravity Desktop users are auto-detected without needing to fill this!
GEMINI_API_KEYS=

          "brand_id": {
            "type": "string",
            "title": "Brand Id"
          },
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "location_region": {
            "type": "string",
            "title": "Location Region"
          },
          "city_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name"
          }
        },
        "type": "object",
        "required": [
          "brand_id",
          "service_id",
          "location_region"
        ],
        "title": "PreviewRequest"
      },
      "PublishRequest": {
        "properties": {
          "brand_id": {
            "type": "string",
            "title": "Brand Id"
          },
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "location_region": {
            "type": "string",
            "title": "Location Region"
          },
          "city_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City Name"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "publish"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password"
          },
          "login_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Login Path",
            "default": "/pawon/"
          }
        },
        "type": "object",
        "required": [
          "brand_id",
          "service_id",
          "location_region"
        ],
        "title": "PublishRequest"
      },
      "SheetImportRequest": {
        "properties": {
          "sheet_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sheet Url"
          },
          "csv_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Csv Content"
          }
        },
        "type": "object",
        "title": "SheetImportRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
